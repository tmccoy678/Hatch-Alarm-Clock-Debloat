#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

start_service() {
    local audio_pipe=/tmp/rose-airplay.pcm
    local lan_address

    lan_address="$(uci -q get network.lan.ipaddr)"
    [ -n "$lan_address" ] || return 1

    if [ -e "$audio_pipe" ] && [ ! -p "$audio_pipe" ]; then
        mv "$audio_pipe" "${audio_pipe}.unexpected"
    fi
    [ -p "$audio_pipe" ] || mkfifo "$audio_pipe"

    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd
    procd_append_param command -f
    procd_append_param command -p "$lan_address:18080"
    procd_append_param command -h /www/rose-relay
    procd_append_param command -x /cgi-bin
    procd_append_param command -t 0
    procd_append_param command -T 30
    procd_append_param command -n 1
    procd_append_param command -N 2
    procd_set_param respawn 3600 5 0
    procd_set_param file /www/rose-relay/cgi-bin/stream.mp3
    procd_close_instance
}
